<script>
// ══════════════════════════════
// STATE
// ══════════════════════════════
let currentWeek    = 1;
let currentDayData = null;
let timerRunning   = false;
let timerSeconds   = 150;
let timerInterval  = null;
let currentUser    = null;
let clientRecord   = null;
let programRecord  = null;
let allDays        = [];
let allExercises   = {};   // keyed by day.id -> array
let logCache       = {};   // keyed by `${dayId}_${exId}_${setNum}`
let noteCache      = {};   // keyed by day.id

const PROFILE_KEY  = 'dom_nick_profile';

// ── RECOVERY PROTOCOLS ────────────────────────────
const TUESDAY_RECOVERY = { activities: [
  { title: 'Option A — Full-Body Foam Roll + Stretch (Recommended)', detail: 'Foam roll: upper back (90s), lats (60s each), quads + IT band (60s each leg). Hip flexor stretch (90s each side). Pigeon pose (90s each side). Box breathing (5 min): 4 in, 4 hold, 4 out, 4 hold.' },
  { title: 'Option B — Low-Intensity Cardio', detail: '20–30 min easy walk, light cycling, or swimming. Heart rate under 130 BPM. Breathing conversational the whole time.' },
  { title: 'Why This Day Exists', detail: 'Your body is adapting from Monday right now. This session keeps blood moving and speeds that process up. It sets you up for a better Wednesday.' },
]};
const SATURDAY_RECOVERY = { activities: [
  { title: 'Option A — Full-Body Foam Roll + Stretch (Recommended)', detail: 'Foam roll: quads + IT band (60s each leg), hamstrings + glutes (60s each leg), upper back (90s). Couch stretch (90s each side). World\'s Greatest Stretch (5 reps each side). Box breathing (5 min).' },
  { title: 'Option B — Easy Cardio', detail: '20–30 min easy walk, light cycling, or swimming. Conversational pace. Heart rate under 130 BPM.' },
  { title: 'Why This Day Exists', detail: 'You\'ve done 3 hard lifting sessions plus a full body day this week. This session is how all that work shows up as actual muscle.' },
]};

// ── PROFILE (localStorage) ────────────────────────
const DEFAULT_PROFILE = { name:'Nick Garberina', age:'25', height:'5\'6"', weight:'140 lbs', gym:"Gold's Gym", sleep:'8–9 hrs', stress:'Moderate–High' };
function loadProfile() {
  try { const s=localStorage.getItem(PROFILE_KEY); return s ? Object.assign({},DEFAULT_PROFILE,JSON.parse(s)) : Object.assign({},DEFAULT_PROFILE); }
  catch(e) { return Object.assign({},DEFAULT_PROFILE); }
}
function saveProfileField(field,value) {
  const p=loadProfile(); p[field]=value;
  localStorage.setItem(PROFILE_KEY,JSON.stringify(p));
}
function saveAndReturnProfile() { renderProfileScreen(); showTab('profile'); }

// ── SUPABASE DATA HELPERS ─────────────────────────
function logKey(dId,eId,s) { return dId+'_'+eId+'_'+s; }

function getLog(dId,eId,setNum) { return logCache[logKey(dId,eId,setNum)] || null; }

async function upsertLog(dId,eId,setNum,field,value) {
  if (!clientRecord) return;
  const key=logKey(dId,eId,setNum);
  const ex=logCache[key]||{};
  const payload={
    client_id:clientRecord.id, day_id:dId, exercise_id:eId, set_number:setNum,
    weight:   field==='weight' ? (parseFloat(value)||null) : (ex.weight??null),
    reps:     field==='reps'   ? (parseInt(value)||null)   : (ex.reps??null),
    completed:field==='completed' ? value : (ex.completed??false),
    logged_at:new Date().toISOString()
  };
  const {data}=await supa.from('workout_logs').upsert(payload,{onConflict:'client_id,day_id,exercise_id,set_number'}).select().single();
  if(data) logCache[key]=data;
}

function isDayDone(dayId) { return noteCache[dayId]?.day_completed||false; }

async function saveDayDone(dayId,done) {
  if (!clientRecord) return;
  const ex=noteCache[dayId];
  const payload={client_id:clientRecord.id,day_id:dayId,notes:ex?.notes||'',day_completed:done,completed_at:done?new Date().toISOString():null};
  const {data}=await supa.from('session_notes').upsert(payload,{onConflict:'client_id,day_id'}).select().single();
  if(data) noteCache[dayId]=data;
}

async function saveNoteText(dayId,text) {
  if (!clientRecord) return;
  const ex=noteCache[dayId];
  const payload={client_id:clientRecord.id,day_id:dayId,notes:text,day_completed:ex?.day_completed||false,completed_at:ex?.completed_at||null};
  const {data}=await supa.from('session_notes').upsert(payload,{onConflict:'client_id,day_id'}).select().single();
  if(data) noteCache[dayId]=data;
}

function loadNotes(dayId) { return noteCache[dayId]?.notes||''; }

function getLastWeekBestSet(currentDay,exIdx,sets) {
  const lastWeekDayNum=currentDay.day_number-6;
  if(lastWeekDayNum<1) return null;
  const lastDay=allDays.find(d=>d.day_number===lastWeekDayNum);
  if(!lastDay) return null;
  const exList=(allExercises[lastDay.id]||[]);
  const ex=exList[exIdx]; if(!ex) return null;
  let best=null;
  for(let s=1;s<=sets;s++){
    const log=getLog(lastDay.id,ex.id,s);
    if(!log?.completed||!log.weight||!log.reps) continue;
    if(!best||log.weight>best.lbs||(log.weight===best.lbs&&log.reps>best.reps)) best={lbs:log.weight,reps:log.reps};
  }
  return best;
}

// ── AUTH ──────────────────────────────────────────
async function doLogin() {
  const email=document.getElementById('login-email').value.trim();
  const pass=document.getElementById('login-password').value;
  const errEl=document.getElementById('login-error');
  errEl.textContent='';
  if(!email||!pass){errEl.textContent='Enter your email and password.';return;}
  const btn=document.querySelector('#screen-login button');
  btn.textContent='LOGGING IN...';btn.disabled=true;
  const {error}=await supa.auth.signInWithPassword({email,password:pass});
  btn.textContent='LOG IN';btn.disabled=false;
  if(error) errEl.textContent='Incorrect email or password.';
}

async function loadClientData() {
  const {data:clients}=await supa.from('clients').select('*').eq('user_id',currentUser.id).limit(1);
  clientRecord=clients?.[0]||null;
  if(!clientRecord) return;

  const {data:programs}=await supa.from('programs').select('*').eq('client_id',clientRecord.id).eq('status','active').limit(1);
  programRecord=programs?.[0]||null;
  if(!programRecord) return;

  const {data:days}=await supa.from('days').select('*').eq('program_id',programRecord.id).order('day_number');
  allDays=days||[];

  const dayIds=allDays.map(d=>d.id);
  if(dayIds.length){
    const {data:exs}=await supa.from('exercises').select('*').in('day_id',dayIds).order('sort_order');
    (exs||[]).forEach(ex=>{ if(!allExercises[ex.day_id]) allExercises[ex.day_id]=[]; allExercises[ex.day_id].push(ex); });
    const {data:logs}=await supa.from('workout_logs').select('*').eq('client_id',clientRecord.id);
    (logs||[]).forEach(l=>{ logCache[logKey(l.day_id,l.exercise_id,l.set_number)]=l; });
    const {data:notes}=await supa.from('session_notes').select('*').eq('client_id',clientRecord.id);
    (notes||[]).forEach(n=>{ noteCache[n.day_id]=n; });
  }
}

// ── NAV ───────────────────────────────────────────
function showTab(tab) {
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  const s=document.getElementById('screen-'+tab);
  if(s) s.classList.add('active');
  if(tab==='schedule') { buildWeekTabs(); renderSchedule(); }
  else if(tab==='progress') renderProgress();
  else if(tab==='profile') renderProfileScreen();
  else if(tab==='settings') populateSettingsForm();
  // supplements/coaching just show their static HTML
}

function goBack() {
  stopTimer();
  showTab('schedule');
}

function buildWeekTabs() {
  const container=document.getElementById('week-tabs-container');
  if(!container) return;
  container.innerHTML='';
  const totalWeeks=programRecord?.duration_weeks||8;
  for(let w=1;w<=totalWeeks;w++){
    const isB2=w>=5;
    const btn=document.createElement('button');
    btn.className='week-tab'+(w===currentWeek?' active':'');
    btn.id='tab-w'+w;
    btn.onclick=()=>switchWeek(w);
    btn.innerHTML='Week '+w+'<span class="week-block-badge">'+(isB2?'Block 2':'Block 1')+'</span>';
    container.appendChild(btn);
  }
}

function switchWeek(w) {
  currentWeek=w;
  for(let i=1;i<=8;i++){const t=document.getElementById('tab-w'+i);if(t)t.classList.toggle('active',i===w);}
  renderSchedule();
  const at=document.getElementById('tab-w'+w);
  if(at) at.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
}

// ── SCHEDULE ─────────────────────────────────────
function getTodayDayNum() {
  if(!programRecord?.start_date) return -1;
  const start=new Date(programRecord.start_date);
  const today=new Date();
  const diff=Math.floor((today-start)/86400000)+1;
  return diff>=1&&diff<=(programRecord.duration_weeks*7)?diff:-1;
}

function renderSchedule() {
  const days=allDays.filter(d=>d.week_number===currentWeek);
  const list=document.getElementById('day-list');
  if(!list) return;
  list.innerHTML='';
  const todayNum=getTodayDayNum();

  days.forEach(day=>{
    const done=isDayDone(day.id);
    const isToday=day.day_number===todayNum;
    const card=document.createElement('div');
    card.className='day-card'+(isToday?' today':'')+(done?' completed':'');
    let meta=day.type==='rest'?'Full Rest — Mandatory':(day.focus||'Active Recovery')+(day.duration?' · '+day.duration:'');
    let badge=isToday&&!done?'<span class="today-badge">Today</span>':done?'<span class="done-badge">Done ✓</span>':'';
    const arrow=day.type==='rest'?'—':'›';
    const pos=((day.day_number-1)%6)+1;
    card.innerHTML='<div class="day-card-inner"><div class="day-number">'+pos+'</div><div class="day-info"><div class="day-name">'+day.label+' — '+day.name+badge+'</div><div class="day-meta">'+meta+'</div></div><div class="day-arrow">'+arrow+'</div></div>';
    if(day.type!=='rest') card.addEventListener('click',()=>openWorkout(day));
    list.appendChild(card);
  });
}

// ── WORKOUT ──────────────────────────────────────
function openWorkout(day) {
  currentDayData=day;
  document.getElementById('screen-schedule').classList.remove('active');
  document.getElementById('screen-workout').classList.add('active');
  document.getElementById('workout-title').textContent=day.name;
  document.getElementById('workout-chip').textContent='Week '+day.week_number+' · '+day.label;
  document.getElementById('workout-meta').textContent=(clientRecord?.name||'Nick')+' · '+(clientRecord?.gym||"Gold's Gym")+(day.duration?' · '+day.duration:'');

  const scroll=document.getElementById('workout-scroll');
  scroll.innerHTML='';
  resetTimer(true);

  if(day.type==='recovery'){renderRecovery(scroll,day);return;}

  const exercises=allExercises[day.id]||[];
  const sectionOrder=[];
  const sectionMap={};
  exercises.forEach(ex=>{
    const lbl=ex.section_label||'Exercises';
    if(!sectionMap[lbl]){sectionMap[lbl]=[];sectionOrder.push(lbl);}
    sectionMap[lbl].push(ex);
  });
  const totalSets=exercises.reduce((a,ex)=>a+(ex.sets||3),0);

  // Progress bar
  const pw=el('div','progress-wrap');
  pw.innerHTML='<div class="progress-top"><span class="progress-label">Session progress</span><span class="progress-pct" id="prog-pct">0%</span></div><div class="prog-bar-bg"><div class="prog-bar-fill" id="prog-fill" style="width:0%"></div></div>';
  scroll.appendChild(pw);

  // Timer
  const tc=el('div','timer-card');
  tc.innerHTML='<div class="timer-left"><div class="timer-label">Rest Timer</div><div class="timer-display" id="timer-disp">2:30</div></div><div class="timer-right"><button class="timer-btn secondary" onclick="resetTimer()">Reset</button><button class="timer-btn" id="timer-btn-main" onclick="toggleTimer()">Start</button></div>';
  scroll.appendChild(tc);

  let exGlobalIdx=0;
  sectionOrder.forEach(sectionLbl=>{
    const lbl=el('div','section-label');
    lbl.textContent=sectionLbl;
    scroll.appendChild(lbl);

    sectionMap[sectionLbl].forEach(ex=>{
      const isWarm=/warm|recovery/i.test(sectionLbl);
      const eIdx=exGlobalIdx;
      const exCard=el('div','ex-card');
      const setCount=ex.sets||3;

      // Last week reference
      const lastBest=!isWarm?getLastWeekBestSet(day,eIdx,setCount):null;
      const lastLine=lastBest?'<div style="font-size:11px;color:var(--green);margin-top:3px;font-family:\'DM Mono\',monospace;">↑ Last week: '+lastBest.lbs+' lbs × '+lastBest.reps+' reps</div>':'';

      let hdr='<div><div class="ex-name">'+ex.exercise_name+'</div><div class="ex-prescription">'+(ex.prescription||'')+'</div>'+lastLine+'</div>';
      if(ex.is_pr_zone) hdr+='<span class="pr-badge">PR Zone</span>';

      let setsHTML='';
      if(!isWarm){
        setsHTML='<div class="set-header"><span>Set</span><span>Lbs</span><span>Reps</span><span></span></div>';
        for(let s=1;s<=setCount;s++){
          const log=getLog(day.id,ex.id,s);
          const lbs=log?.weight??'';
          const reps=log?.reps??'';
          const done=log?.completed||false;
          const dId=day.id, eId=ex.id;
          setsHTML+='<div class="set-row">'+
            '<span class="set-num">'+s+'</span>'+
            '<input class="set-input'+(done?' saved':'')+'" type="number" inputmode="decimal" placeholder="lbs" value="'+lbs+'" onchange="onInput(\''+dId+'\',\''+eId+'\','+s+',\'weight\',this.value)">'+
            '<input class="set-input'+(done?' saved':'')+'" type="number" inputmode="decimal" placeholder="reps" value="'+reps+'" onchange="onInput(\''+dId+'\',\''+eId+'\','+s+',\'reps\',this.value)">'+
            '<button class="check-btn'+(done?' done':'')+'" id="chk-'+dId+'-'+eId+'-'+s+'" onclick="toggleSet(\''+dId+'\',\''+eId+'\','+s+','+totalSets+')">✓</button>'+
            '</div>';
        }
      } else {
        const log=getLog(day.id,ex.id,1);
        const done=log?.completed||false;
        hdr+='<button class="check-btn'+(done?' done':'')+'" id="chk-'+day.id+'-'+ex.id+'-1" onclick="toggleSet(\''+day.id+'\',\''+ex.id+'\',1,'+totalSets+')">✓</button>';
      }

      exCard.innerHTML='<div class="ex-header">'+hdr+'</div>'+setsHTML;
      scroll.appendChild(exCard);
      exGlobalIdx++;
    });
  });

  // Notes
  const nc=el('div','notes-card');
  const dId2=day.id;
  nc.innerHTML='<div class="notes-label">Session Notes</div><textarea class="notes-input" placeholder="How did it feel? Any PRs? Notes for next session..." onchange="saveNoteText(\''+dId2+'\',this.value)">'+loadNotes(day.id)+'</textarea>';
  scroll.appendChild(nc);

  // Finish btn
  const dayDone=isDayDone(day.id);
  const fb=el('button',dayDone?'finish-btn done-btn':'finish-btn');
  fb.id='finish-btn';
  fb.textContent=dayDone?'✓ WORKOUT COMPLETE — Tap to Undo':'FINISH WORKOUT';
  fb.onclick=()=>finishWorkout(day.id);
  scroll.appendChild(fb);
  scroll.appendChild(el('div','safe-bottom'));
  updateProgress(day.id,totalSets);
}

function renderRecovery(scroll,day) {
  const protocol=day.label==='Saturday'?SATURDAY_RECOVERY:TUESDAY_RECOVERY;
  const card=el('div','recovery-card');
  card.innerHTML='<div class="recovery-icon">'+(day.label==='Saturday'?'🌀':'🧘')+'</div><div class="recovery-title">Active Recovery Day</div><div class="recovery-text">'+(day.label==='Saturday'?'Close the week right. Full-body reset.':'Your body is adapting from Monday. Keep blood moving.')+'</div>';
  const list=el('div','recovery-list');
  protocol.activities.forEach(a=>{
    const item=el('div','recovery-item');
    item.innerHTML='<span class="rec-bullet">▸</span><div class="rec-text"><strong>'+a.title+'</strong><br>'+a.detail+'</div>';
    list.appendChild(item);
  });
  card.appendChild(list);
  scroll.appendChild(card);
  const nc=el('div','notes-card');
  const dId=day.id;
  nc.innerHTML='<div class="notes-label">Recovery Notes</div><textarea class="notes-input" placeholder="How\'s the body feeling? Any soreness to flag?" onchange="saveNoteText(\''+dId+'\',this.value)">'+loadNotes(day.id)+'</textarea>';
  scroll.appendChild(nc);
  const done=isDayDone(day.id);
  const fb=el('button',done?'finish-btn done-btn':'finish-btn');
  fb.textContent=done?'✓ RECOVERY LOGGED — Tap to Undo':'LOG RECOVERY DAY';
  fb.onclick=()=>{
    const nowDone=!isDayDone(day.id);
    saveDayDone(day.id,nowDone);
    fb.textContent=nowDone?'✓ RECOVERY LOGGED — Tap to Undo':'LOG RECOVERY DAY';
    fb.className=nowDone?'finish-btn done-btn':'finish-btn';
  };
  scroll.appendChild(fb);
  scroll.appendChild(el('div','safe-bottom'));
}

// ── SET TRACKING ─────────────────────────────────
function onInput(dayId,exId,setNum,field,value) {
  upsertLog(dayId,exId,setNum,field,value);
}

function toggleSet(dayId,exId,setNum,totalSets) {
  const key=logKey(dayId,exId,setNum);
  const newDone=!(logCache[key]?.completed);
  upsertLog(dayId,exId,setNum,'completed',newDone);
  const btn=document.getElementById('chk-'+dayId+'-'+exId+'-'+setNum);
  if(btn) btn.className='check-btn'+(newDone?' done':'');
  const row=btn?.closest('.set-row');
  if(row) row.querySelectorAll('.set-input').forEach(i=>i.className='set-input'+(newDone?' saved':''));
  updateProgress(dayId,totalSets);
  if(newDone){resetTimer(true);toggleTimer();}
}

function updateProgress(dayId,totalSets) {
  let done=Object.values(logCache).filter(l=>l.day_id===dayId&&l.completed).length;
  const pct=totalSets>0?Math.round((done/totalSets)*100):0;
  const fill=document.getElementById('prog-fill');
  const pctEl=document.getElementById('prog-pct');
  if(fill) fill.style.width=pct+'%';
  if(pctEl) pctEl.textContent=pct+'%';
}

function finishWorkout(dayId) {
  const newState=!isDayDone(dayId);
  saveDayDone(dayId,newState);
  const btn=document.getElementById('finish-btn');
  if(btn){btn.textContent=newState?'✓ WORKOUT COMPLETE — Tap to Undo':'FINISH WORKOUT';btn.className=newState?'finish-btn done-btn':'finish-btn';}
}

// ── TIMER ────────────────────────────────────────
function toggleTimer() {
  if(timerRunning){stopTimer();}
  else{
    timerRunning=true;
    document.getElementById('timer-btn-main').textContent='Stop';
    timerInterval=setInterval(()=>{
      timerSeconds--;updateTimerDisplay();
      if(timerSeconds<=0){stopTimer();const d=document.getElementById('timer-disp');if(d)d.classList.add('done-color');document.getElementById('timer-btn-main').textContent='Done!';}
    },1000);
  }
}
function stopTimer(){clearInterval(timerInterval);timerRunning=false;const b=document.getElementById('timer-btn-main');if(b)b.textContent='Start';}
function resetTimer(silent){stopTimer();timerSeconds=150;const d=document.getElementById('timer-disp');if(d){d.textContent='2:30';d.classList.remove('done-color');}}
function updateTimerDisplay(){const m=Math.floor(timerSeconds/60),s=timerSeconds%60;const d=document.getElementById('timer-disp');if(d)d.textContent=m+':'+(s<10?'0':'')+s;}

// ── PROGRESS ─────────────────────────────────────
function renderProgress() {
  const scroll=document.getElementById('progress-scroll');
  scroll.innerHTML='';
  const workoutDays=allDays.filter(d=>d.type==='workout');
  const doneWorkouts=workoutDays.filter(d=>isDayDone(d.id)).length;
  const trackable=allDays.filter(d=>d.type!=='rest');
  const doneDays=trackable.filter(d=>isDayDone(d.id)).length;
  const totalWeeks=programRecord?.duration_weeks||8;

  const grid=el('div','stat-grid');
  grid.innerHTML='<div class="stat-card"><div class="stat-value">'+doneWorkouts+'</div><div class="stat-label">Workouts Done</div></div>'+
    '<div class="stat-card"><div class="stat-value">'+(workoutDays.length-doneWorkouts)+'</div><div class="stat-label">Remaining</div></div>'+
    '<div class="stat-card"><div class="stat-value">'+doneDays+'</div><div class="stat-label">Days Logged</div></div>'+
    '<div class="stat-card"><div class="stat-value">'+Math.round((doneDays/Math.max(trackable.length,1))*100)+'%</div><div class="stat-label">Program Complete</div></div>';
  scroll.appendChild(grid);

  const todayNum=getTodayDayNum();
  for(let w=1;w<=totalWeeks;w++){
    const wdays=allDays.filter(d=>d.week_number===w);
    const isB2=w>=5;
    const wc=el('div','week-summary');
    const dots=wdays.map(d=>{
      if(d.type==='rest') return '<div class="day-dot rest"></div>';
      if(isDayDone(d.id)) return '<div class="day-dot done"></div>';
      if(d.day_number===todayNum) return '<div class="day-dot today-dot"></div>';
      return '<div class="day-dot"></div>';
    }).join('');
    const labels=wdays.map(d=>'<div style="flex:1;text-align:center;font-size:9px;color:var(--text-dim);margin-top:4px;">'+d.label.slice(0,2)+'</div>').join('');
    wc.innerHTML='<div class="week-summary-title" style="display:flex;justify-content:space-between;align-items:center;"><span>Week '+w+'</span><span style="font-size:10px;color:'+(isB2?'var(--red)':'var(--text-muted)')+';letter-spacing:0.06em;">'+(isB2?'Block 2 — Intensification':'Block 1 — Volume')+'</span></div><div class="day-dots">'+dots+'</div><div style="display:flex;gap:6px;margin-top:2px">'+labels+'</div>';
    scroll.appendChild(wc);
  }

  const sl=el('div','detail-link-card');sl.onclick=()=>showTab('supplements');
  sl.innerHTML='<div><div class="detail-link-eyebrow">Reference</div><div class="detail-link-title">Supplement Recommendations</div><div class="detail-link-sub">Creatine, D3, Magnesium, Fish Oil &amp; more</div></div><div class="detail-link-arrow">›</div>';
  scroll.appendChild(sl);

  const cl=el('div','detail-link-card');cl.onclick=()=>showTab('coaching');
  cl.innerHTML='<div><div class="detail-link-eyebrow">Reference</div><div class="detail-link-title">Coaching Notes &amp; Key Reminders</div><div class="detail-link-sub">Rules, principles, and what never changes</div></div><div class="detail-link-arrow">›</div>';
  scroll.appendChild(cl);

  const note=el('div','coach-note');
  note.innerHTML='<div class="coach-label">Progress Note</div><div class="coach-text">Green = completed. Red = today. Empty = upcoming. Data syncs to the cloud — your logs are saved across all devices.</div>';
  scroll.appendChild(note);
  scroll.appendChild(el('div','safe-bottom'));
}

// ── PROFILE ──────────────────────────────────────
