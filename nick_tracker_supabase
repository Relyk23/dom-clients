<style>
:root{--red:#CC0000;--red-dark:#990000;--red-dim:rgba(204,0,0,0.12);--black:#080808;--surface:#111111;--surface2:#1a1a1a;--surface3:#222222;--border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);--text:#f0f0f0;--text-muted:#666;--text-dim:#444;--green:#22c55e;--green-dim:rgba(34,197,94,0.12);}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;background:var(--black);font-family:'DM Sans',sans-serif;color:var(--text);overscroll-behavior:none;}
body{display:flex;flex-direction:column;max-width:430px;margin:0 auto;height:100dvh;}
.screen{display:none;flex-direction:column;height:100%;}
.screen.active{display:flex;}
.safe-top{height:env(safe-area-inset-top,12px);background:var(--black);min-height:12px;}
.safe-bottom{height:env(safe-area-inset-bottom,8px);min-height:8px;}
.app-header{background:var(--black);padding:10px 20px 12px;border-bottom:1px solid var(--border);flex-shrink:0;}
.header-brand{font-family:'Bebas Neue',sans-serif;font-size:11px;letter-spacing:0.2em;color:var(--red);margin-bottom:4px;}
.header-row{display:flex;justify-content:space-between;align-items:flex-end;}
.header-title{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:0.06em;line-height:1;color:var(--text);}
.header-sub{font-size:12px;color:var(--text-muted);}
.scroll-body{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:16px;display:flex;flex-direction:column;gap:10px;}
.bottom-nav{background:var(--black);border-top:1px solid var(--border);display:flex;justify-content:space-around;padding:10px 0;flex-shrink:0;}
.nav-btn{display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:none;cursor:pointer;padding:4px 16px;}
.nav-icon{font-size:18px;opacity:0.35;transition:opacity 0.15s;}
.nav-label{font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);}
.nav-btn.active .nav-icon{opacity:1;}
.nav-btn.active .nav-label{color:var(--red);}
.week-tabs-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-bottom:4px;}
.week-tabs-scroll::-webkit-scrollbar{display:none;}
.week-tabs{display:flex;gap:6px;width:max-content;padding-bottom:2px;}
.week-tab{flex-shrink:0;padding:8px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;font-family:'DM Sans',sans-serif;font-size:12px;color:var(--text-muted);cursor:pointer;transition:all 0.15s;white-space:nowrap;}
.week-tab.active{background:var(--red-dim);border-color:var(--red);color:var(--text);}
.week-block-badge{display:block;font-size:9px;color:var(--text-dim);letter-spacing:0.06em;margin-top:1px;}
.week-tab.active .week-block-badge{color:var(--red);opacity:0.8;}
.day-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;flex-shrink:0;cursor:pointer;transition:border-color 0.15s;}
.day-card.today{border-color:var(--red);}
.day-card.completed{border-color:rgba(34,197,94,0.4);}
.day-card-inner{display:flex;align-items:center;padding:14px 16px;gap:14px;}
.day-number{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--text-dim);line-height:1;min-width:32px;text-align:center;}
.day-card.today .day-number{color:var(--red);}
.day-card.completed .day-number{color:var(--green);}
.day-info{flex:1;}
.day-name{font-size:15px;font-weight:500;color:var(--text);margin-bottom:2px;}
.day-meta{font-size:12px;color:var(--text-muted);}
.day-arrow{color:var(--text-dim);font-size:16px;}
.day-card.today .day-arrow{color:var(--red);}
.day-card.completed .day-arrow{color:var(--green);}
.today-badge{background:var(--red);color:#fff;font-size:9px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:2px 7px;border-radius:20px;margin-left:6px;}
.done-badge{background:var(--green-dim);color:var(--green);font-size:9px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:2px 7px;border-radius:20px;margin-left:6px;}
.workout-header{background:var(--black);padding:12px 20px 14px;border-bottom:1px solid var(--border);flex-shrink:0;}
.back-btn{display:flex;align-items:center;gap:6px;background:none;border:none;color:var(--red);font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer;padding:0;margin-bottom:8px;}
.workout-brand{font-family:'Bebas Neue',sans-serif;font-size:10px;letter-spacing:0.2em;color:var(--text-dim);margin-bottom:2px;}
.workout-title-row{display:flex;justify-content:space-between;align-items:flex-start;}
.workout-big-title{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:0.04em;line-height:1.1;}
.day-chip{background:var(--red);color:#fff;font-size:10px;font-weight:600;padding:3px 10px;border-radius:20px;letter-spacing:0.06em;white-space:nowrap;margin-top:4px;}
.workout-meta-row{font-size:12px;color:var(--text-muted);margin-top:4px;}
.progress-wrap{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 14px;}
.progress-top{display:flex;justify-content:space-between;margin-bottom:8px;}
.progress-label{font-size:12px;color:var(--text-muted);}
.progress-pct{font-size:12px;font-weight:500;color:var(--text);}
.prog-bar-bg{height:4px;background:var(--surface3);border-radius:2px;}
.prog-bar-fill{height:100%;background:var(--red);border-radius:2px;transition:width 0.4s ease;}
.section-label{font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:0.15em;color:var(--red);padding:4px 0 2px;}
.ex-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;flex-shrink:0;}
.ex-header{display:flex;justify-content:space-between;align-items:center;padding:12px 14px 10px;border-bottom:1px solid var(--border);}
.ex-name{font-size:15px;font-weight:500;color:var(--text);}
.ex-prescription{font-size:11px;color:var(--text-muted);margin-top:2px;}
.pr-badge{background:var(--red-dim);color:var(--red);border:1px solid rgba(204,0,0,0.3);font-size:9px;font-weight:600;letter-spacing:0.08em;padding:3px 8px;border-radius:20px;white-space:nowrap;margin-left:8px;}
.set-header{display:grid;grid-template-columns:28px 1fr 1fr 40px;gap:8px;padding:8px 14px 4px;color:var(--text-dim);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;font-family:'DM Mono',monospace;border-bottom:1px solid var(--border);}
.set-header span{text-align:center;}
.set-row{display:grid;grid-template-columns:28px 1fr 1fr 40px;gap:8px;padding:5px 14px;align-items:center;}
.set-row:last-child{padding-bottom:14px;}
.set-num{font-family:'DM Mono',monospace;font-size:12px;color:var(--text-dim);text-align:center;}
.set-input{background:var(--surface2);border:1px solid var(--border2);border-radius:8px;color:var(--text);font-size:15px;font-family:'DM Mono',monospace;text-align:center;padding:9px 4px;width:100%;outline:none;transition:border-color 0.15s,background 0.15s;-webkit-appearance:none;min-height:42px;}
.set-input::placeholder{color:var(--text-dim);}
.set-input:focus{border-color:var(--red);background:var(--surface3);}
.set-input.saved{border-color:rgba(34,197,94,0.5);color:var(--green);background:rgba(34,197,94,0.06);}
.check-btn{width:36px;height:36px;border-radius:50%;border:1.5px solid var(--surface3);background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.15s;font-size:15px;color:var(--text-dim);flex-shrink:0;}
.check-btn.done{background:var(--green);border-color:var(--green);color:#fff;}
.check-btn:active{transform:scale(0.9);}
.notes-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 14px;}
.notes-label{font-size:11px;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:6px;font-family:'DM Mono',monospace;}
.notes-input{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;padding:10px 12px;min-height:70px;resize:none;outline:none;transition:border-color 0.15s;}
.notes-input:focus{border-color:var(--red);}
.timer-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;}
.timer-left{display:flex;flex-direction:column;gap:2px;}
.timer-label{font-size:11px;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;font-family:'DM Mono',monospace;}
.timer-display{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:0.06em;color:var(--red);line-height:1;transition:color 0.3s;}
.timer-display.done-color{color:var(--green);}
.timer-right{display:flex;gap:8px;}
.timer-btn{background:var(--red);color:#fff;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;padding:8px 16px;cursor:pointer;transition:background 0.15s;}
.timer-btn:active{background:var(--red-dark);}
.timer-btn.secondary{background:var(--surface3);}
.finish-btn{background:var(--red);color:#fff;border:none;border-radius:12px;font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:0.1em;padding:16px;width:100%;cursor:pointer;transition:background 0.15s;}
.finish-btn:active{background:var(--red-dark);}
.finish-btn.done-btn{background:var(--green);}
.recovery-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px 16px;text-align:center;}
.recovery-icon{font-size:36px;margin-bottom:10px;}
.recovery-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:0.06em;margin-bottom:6px;}
.recovery-text{font-size:13px;color:var(--text-muted);line-height:1.6;}
.recovery-list{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:left;margin-top:12px;display:flex;flex-direction:column;gap:10px;}
.recovery-item{display:flex;align-items:flex-start;gap:10px;}
.rec-bullet{color:var(--red);font-size:16px;line-height:1.4;flex-shrink:0;}
.rec-text{font-size:13px;color:var(--text-muted);line-height:1.5;}
.rec-text strong{color:var(--text);font-weight:500;}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;}
.stat-value{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:0.04em;color:var(--text);line-height:1;margin-bottom:4px;}
.stat-label{font-size:11px;color:var(--text-muted);letter-spacing:0.06em;text-transform:uppercase;}
.week-summary{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;}
.week-summary-title{font-size:13px;font-weight:500;color:var(--text);margin-bottom:10px;}
.day-dots{display:flex;gap:6px;}
.day-dot{flex:1;height:6px;border-radius:3px;background:var(--surface3);transition:background 0.3s;}
.day-dot.done{background:var(--green);}
.day-dot.rest{background:var(--surface2);border:1px solid var(--border);}
.day-dot.today-dot{background:var(--red);}
.detail-link-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;transition:border-color 0.15s;}
.detail-link-eyebrow{font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--red);font-family:'Bebas Neue',sans-serif;margin-bottom:3px;}
.detail-link-title{font-size:15px;font-weight:500;color:var(--text);line-height:1.3;}
.detail-link-sub{font-size:12px;color:var(--text-muted);margin-top:2px;}
.detail-link-arrow{color:var(--red);font-size:18px;}
.detail-section-title{font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:0.15em;color:var(--red);padding:4px 0 2px;}
.detail-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px;}
.detail-item{display:flex;flex-direction:column;gap:4px;padding:12px 0;border-bottom:1px solid var(--border);}
.detail-item:last-child{border-bottom:none;padding-bottom:0;}
.detail-item:first-child{padding-top:0;}
.detail-item-name{font-size:14px;font-weight:500;color:var(--text);}
.detail-item-dose{font-size:12px;color:var(--red);font-family:'DM Mono',monospace;margin-top:1px;}
.detail-item-desc{font-size:12px;color:var(--text-muted);line-height:1.5;margin-top:2px;}
.coaching-item{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);}
.coaching-item:last-child{border-bottom:none;padding-bottom:0;}
.coaching-item:first-child{padding-top:0;}
.coaching-num{font-family:'Bebas Neue',sans-serif;font-size:22px;color:var(--red);line-height:1;min-width:24px;flex-shrink:0;}
.coaching-rule{font-size:14px;font-weight:500;color:var(--text);margin-bottom:4px;}
.coaching-detail{font-size:12px;color:var(--text-muted);line-height:1.5;}
.disclaimer-text{font-size:11px;color:var(--text-dim);text-align:center;line-height:1.5;padding:4px 8px;}
.profile-header{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;display:flex;align-items:center;gap:16px;}
.avatar{width:52px;height:52px;border-radius:50%;background:var(--red);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:0.06em;color:#fff;flex-shrink:0;}
.profile-name{font-size:18px;font-weight:500;color:var(--text);}
.profile-meta{font-size:12px;color:var(--text-muted);margin-top:2px;}
.info-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;flex-shrink:0;}
.info-row{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border);}
.info-row:last-child{border-bottom:none;}
.info-key{font-size:13px;color:var(--text-muted);}
.info-val{font-size:13px;font-weight:500;color:var(--text);text-align:right;max-width:60%;}
.info-row-stacked{display:flex;flex-direction:column;gap:6px;padding:14px 16px;border-bottom:1px solid var(--border);}
.info-row-stacked:last-child{border-bottom:none;}
.info-key-stacked{font-size:11px;color:var(--text-muted);letter-spacing:0.06em;text-transform:uppercase;font-family:'DM Mono',monospace;}
.info-val-stacked{font-size:14px;font-weight:500;color:var(--text);}
.coach-note{background:var(--red-dim);border:1px solid rgba(204,0,0,0.25);border-radius:12px;padding:14px 16px;}
.coach-label{font-size:10px;letter-spacing:0.12em;color:var(--red);text-transform:uppercase;font-weight:600;margin-bottom:6px;}
.coach-text{font-size:13px;color:var(--text-muted);line-height:1.6;}
.settings-gear{background:none;border:none;color:var(--text-muted);font-size:20px;cursor:pointer;padding:4px;line-height:1;transition:color 0.15s;}
.settings-gear:active{color:var(--red);}
.settings-field-label{font-size:11px;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;font-family:'DM Mono',monospace;margin-bottom:5px;margin-top:14px;}
.settings-input{width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;padding:10px 12px;outline:none;transition:border-color 0.15s;-webkit-appearance:none;}
.settings-input:focus{border-color:var(--red);}
.settings-locked{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:8px;color:var(--text-muted);font-family:'DM Sans',sans-serif;font-size:14px;padding:10px 12px;display:flex;align-items:center;justify-content:space-between;}
.locked-icon{font-size:12px;color:var(--text-dim);}
.settings-save-btn{background:var(--red);color:#fff;border:none;border-radius:12px;font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:0.1em;padding:16px;width:100%;cursor:pointer;margin-top:8px;transition:background 0.15s;}
.settings-save-btn:active{background:var(--red-dark);}
.settings-section-title{font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:0.15em;color:var(--red);margin-bottom:10px;margin-top:6px;}
.settings-divider{height:1px;background:var(--border);margin:18px 0 14px;}
/* Loading overlay */
.loading-overlay{position:fixed;inset:0;background:var(--black);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;gap:16px;}
.loading-logo{font-family:'Bebas Neue',sans-serif;font-size:48px;letter-spacing:0.06em;color:var(--red);}
.loading-sub{font-size:12px;color:var(--text-muted);letter-spacing:0.12em;text-transform:uppercase;}
.spinner{width:32px;height:32px;border:3px solid var(--surface3);border-top-color:var(--red);border-radius:50%;animation:spin 0.8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
</style>
</head>
<body>

<!-- Loading -->
<div class="loading-overlay" id="loading-overlay">
  <div class="loading-logo">D&gt;M</div>
  <div class="loading-sub">Discipline Over Motivation</div>
  <div class="spinner"></div>
</div>

<!-- LOGIN -->
<div class="screen" id="screen-login">
  <div class="safe-top"></div>
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;background:var(--black);">
    <div style="font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:0.25em;color:var(--red);margin-bottom:6px;">Discipline Over Motivation</div>
    <div style="font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:0.06em;color:var(--text);line-height:1;margin-bottom:2px;">D&gt;M</div>
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:40px;letter-spacing:0.08em;">TRAINING</div>
    <div style="width:100%;max-width:340px;display:flex;flex-direction:column;gap:12px;">
      <div>
        <div style="font-size:11px;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;font-family:'DM Mono',monospace;margin-bottom:6px;">Email</div>
        <input id="login-email" type="email" autocomplete="email" inputmode="email" placeholder="your@email.com"
          style="width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:10px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:15px;padding:13px 14px;outline:none;-webkit-appearance:none;">
      </div>
      <div>
        <div style="font-size:11px;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;font-family:'DM Mono',monospace;margin-bottom:6px;">Password</div>
        <input id="login-password" type="password" autocomplete="current-password" placeholder="••••••••"
          style="width:100%;background:var(--surface2);border:1px solid var(--border2);border-radius:10px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:15px;padding:13px 14px;outline:none;-webkit-appearance:none;">
      </div>
