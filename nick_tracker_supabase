function populateSettingsForm() {
  const p=loadProfile();
  ['name','age','height','weight','gym','sleep'].forEach(f=>{const e=document.getElementById('set-'+f);if(e)e.value=p[f]||'';});
  const st=document.getElementById('set-stress');if(st)st.value=p.stress||'';
}

// ── UTILS ────────────────────────────────────────
function el(tag,cls){const e=document.createElement(tag);if(cls)e.className=cls;return e;}

